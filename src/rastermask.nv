// rastermask.nv — the value this package is built around: coverage,
// eight bits a pixel, with no colour in it.
//
// THIS MODULE IS THE LOAD-BEARING INTERFACE OF THE PACKAGE.
//
// A rasteriser's real output is not pixels.  It is the answer to one
// question per pixel — how much of this pixel does the shape cover? —
// and that answer is a number between 0 and 255 that knows nothing
// about what colour the shape is.  Every design decision in this
// package follows from separating that number from the compositing
// that consumes it:
//
//   A GLYPH CACHE HOLDS MASKS, NOT PIXELS.  A terminal draws the same
//   `e` in sixteen colours; a renderer that cached pixels would
//   rasterise it sixteen times, and one that caches coverage
//   rasterises it once.  `rasterglyph` therefore caches `RstMask` and
//   the colour arrives at the blend.
//
//   A CLIP IS THE SAME VALUE.  Clipping to a shape is `intersect` of
//   two masks, so a clip is anti-aliased for free and a clip to a
//   rotated rectangle is not a special case.  tiny-skia calls this a
//   `ClipMask` and keeps it separate from its pixmap; the separation
//   is the idea, and having one type for both halves is the
//   simplification.
//
//   AND THE 1-BIT CASE IS A THRESHOLD.  An e-paper panel takes one bit
//   a pixel, and `threshold` plus `pack_rows_1bit` is the whole
//   conversion.  See the README's § Does e-paper earn a module for why
//   it is two functions rather than a module.
//
// EIGHT BITS AND NOT SIXTEEN, AND NOT A FLOAT.  A byte is what a
// composite against an 8-bit image can use without rounding twice, it
// is what FreeType, tiny-skia and every font atlas in the world store,
// and it makes a 1024-by-1024 mask one megabyte instead of four.  The
// accumulation inside the scanline sweep is at higher precision; what
// crosses the interface is a byte.
//
// THE MASK CARRIES ITS OWN RECTANGLE, which is the field that makes it
// usable.  A path's coverage is zero almost everywhere, and a mask the
// size of the image would be mostly zeroes — so a mask covers the
// path's bounding box clipped to the target, and `origin_x`/`origin_y`
// say where that box sits.  Two masks combine only when their
// rectangles match, and `RstExtentMismatch` is what skipping the check
// costs.

use geomrect
use rastererror

// A coverage plane: `width * height` bytes, one per pixel, 0 to 255.
//
// Row-major with no padding, so the stride is exactly `width` and a
// caller may treat the whole buffer as one run.  The same layout
// image-nv uses for an 8-bit greyscale image, deliberately: a mask can
// be handed to `image.from_samples` as a `PixLuma8` and written out as
// a PNG, which is how a test looks at what the rasteriser did.
pub struct RstMask
    // Width in pixels.  At least 1.
    width: Int
    // Height in pixels.  At least 1.
    height: Int
    // Where the mask's top-left corner sits in the target image.  May
    // be negative: a shape that starts off the left edge has its box
    // clipped, and the origin is what tells a compositor where the
    // remaining pixels go.
    origin_x: Int
    // Where the mask's top-left corner sits vertically.
    origin_y: Int
    // The coverage bytes, `width * height` of them, row-major.
    coverage: Bytes

// How much a mask is allowed to cost.
//
// A budget that crosses the interface BEFORE anything is allocated.
// The numbers in a path come out of a file, and a file can ask for a
// petabyte; `RstTooLarge` carrying both numbers is what a caller gets
// instead of an allocator failure.
//
// `@value`: two integers passed into every mask-producing call,
// never a `Result` payload and never a boxed field of its own.
pub @value
struct RstLimits
    // The most pixels one mask may cover.  64 Mi (8192 by 8192) is the
    // default, which is a 64 MB buffer.
    max_pixels: Int
    // The most edges one path may contribute to the sweep.  A path is
    // flattened before it is filled, and a curve with a tiny tolerance
    // over a huge coordinate range flattens into millions of segments;
    // this is the bound on that.
    max_edges: Int

// The defaults: 64 Mi pixels and 1 Mi edges.
//
// Published as a function rather than left to a caller to invent,
// because a caller that has no opinion still has to pass something,
// and two callers inventing different numbers is two programs that
// refuse different files.
pub fn default_limits() -> RstLimits []
    RstLimits { max_pixels: 67108864, max_edges: 1048576 }

// A mask of `width` by `height` at an origin, fully transparent.
//
// `RstTooLarge` when the size is past the budget, which is the check
// every mask-producing call in this package makes first.
pub fn mask(width: Int, height: Int, origin_x: Int, origin_y: Int,
            limits: RstLimits) -> Result<RstMask, rastererror.RstFault> []
    build(width, height, origin_x, origin_y, 0, limits)

// A mask covering a rectangle of the target, fully opaque.
//
// The starting clip: a caller that clips to the whole image asks for
// this once and intersects into it.
pub fn full(width: Int, height: Int, origin_x: Int, origin_y: Int,
            limits: RstLimits) -> Result<RstMask, rastererror.RstFault> []
    build(width, height, origin_x, origin_y, 255, limits)

// The integer rectangle a float bounding box needs, clipped to a
// target of `w` by `h`.
//
// The arithmetic between "where the path is" and "which pixels the
// mask covers": the box is rounded OUTWARD, because a pixel a curve
// touches by a hundredth still has coverage, and rounding inward would
// clip the edge of every shape by one pixel in a way that only shows
// against a background.
pub fn extent_for(bounds: geomrect.GeomRectF, w: Int, h: Int) -> geomrect.GeomRectI []
    let outer = geomrect.to_int_outer(bounds)
    let box = geomrect.intersection_i(outer, geomrect.of_xywh_i(0, 0, w, h))
    if geomrect.is_empty_i(box)
        return geomrect.empty_i()
    box

// How many pixels a mask over that rectangle would cost.
//
// Published so a caller can ask before it asks, and so a tiling
// renderer can decide how many tiles it needs without provoking a
// refusal.
pub fn cost_of(extent: geomrect.GeomRectI) -> Int []
    if geomrect.is_empty_i(extent)
        return 0
    pixels_of(geomrect.width_i(extent), geomrect.height_i(extent))

// ── Reading a mask ───────────────────────────────────────────────────

// The coverage at a pixel of the TARGET, 0 outside the mask.
//
// Target coordinates rather than mask coordinates, because that is
// what a compositor and a hit test both have, and converting at every
// call site is where the origin gets forgotten.
pub fn at(m: RstMask, x: Int, y: Int) -> Int []
    let lx = x - m.origin_x
    let ly = y - m.origin_y
    if lx < 0 or ly < 0 or lx >= m.width or ly >= m.height
        return 0
    bytes.byte_at(m.coverage, ly * m.width + lx) ?? 0

// The mask's rectangle in target coordinates.
pub fn extent(m: RstMask) -> geomrect.GeomRectI []
    geomrect.of_xywh_i(m.origin_x, m.origin_y, m.width, m.height)

// One row's coverage bytes, or nothing when `y` is outside.
//
// In mask coordinates, because a caller walking rows is walking the
// mask.  For a compositor that wants the run rather than the pixels.
pub fn row(m: RstMask, y: Int) -> ?Bytes []
    if y < 0 or y >= m.height
        return None
    Some(bytes.slice(m.coverage, y * m.width, (y + 1) * m.width))

// Whether two masks cover the same rectangle.
//
// The check `intersect`, `union` and `subtract` all make, published
// because a caller that combines masks in a loop would rather ask once
// than handle `RstExtentMismatch` three times.
pub fn same_extent(a: RstMask, b: RstMask) -> Bool []
    a.width == b.width and a.height == b.height and a.origin_x == b.origin_x
        and a.origin_y == b.origin_y

// Whether every byte is zero.
//
// The early exit a compositor takes: a shape entirely outside the clip
// produces an empty mask, and drawing it is a no-op that should cost
// nothing.
pub fn is_empty(m: RstMask) -> Bool []
    all_equal(m, 0)

// Whether every byte is 255.
//
// The other early exit: a fully covered mask means the compositor can
// write the source straight in with no per-pixel blend.
pub fn is_opaque(m: RstMask) -> Bool []
    all_equal(m, 255)

// The smallest rectangle outside which every byte is zero.
//
// For a caller that built a mask from a generous box and wants to
// trim it before caching — a glyph cache does exactly that, because
// the path bounds of an `e` are looser than its ink.
pub fn ink_extent(m: RstMask) -> geomrect.GeomRectI []
    var x0 = m.width
    var y0 = m.height
    var x1 = -1
    var y1 = -1
    for y in 0..m.height
        for x in 0..m.width
            if (bytes.byte_at(m.coverage, y * m.width + x) ?? 0) != 0
                x0 = math.min(x0, x)
                x1 = math.max(x1, x)
                y0 = math.min(y0, y)
                y1 = math.max(y1, y)
    if x1 < 0
        return geomrect.of_xywh_i(m.origin_x, m.origin_y, 0, 0)
    geomrect.of_xywh_i(m.origin_x + x0, m.origin_y + y0, x1 - x0 + 1, y1 - y0 + 1)

// ── Combining masks ──────────────────────────────────────────────────

// The pixel-wise minimum: what both masks cover.
//
// THE CLIP OPERATION.  Clipping a fill to a shape is intersecting
// their coverage, which is why a clip in this package is
// anti-aliased and a clip to a rotated rectangle is not a special
// case.  A multiply would be the alternative and is wrong for the
// common case: two masks that each cover a pixel fully should leave it
// fully covered, and 255 times 255 over 255 only just does.
pub fn intersect(a: RstMask, b: RstMask) -> Result<RstMask, rastererror.RstFault> []
    combine(a, b, 0)

// The pixel-wise maximum: what either mask covers.
pub fn union(a: RstMask, b: RstMask) -> Result<RstMask, rastererror.RstFault> []
    combine(a, b, 1)

// What `a` covers and `b` does not.
//
// For a caller drawing a shape with a hole punched by another shape,
// where the two are not one path and a fill rule would not reach.
pub fn subtract(a: RstMask, b: RstMask) -> Result<RstMask, rastererror.RstFault> []
    combine(a, b, 2)

// 255 minus every byte.
pub fn invert(m: RstMask) -> RstMask []
    var out = bytes.clone(m.coverage)
    for i in 0..bytes.len(out)
        bytes.set_u8(out, i, 255 - (bytes.byte_at(m.coverage, i) ?? 0))
    with_coverage(m, out)

// Every byte scaled by `alpha`, which is `0.0 ..= 1.0`.
//
// Group opacity: an SVG `<g opacity="0.5">` is its children composited
// together and then scaled, and a caller that scaled each child
// separately would get a different, wrong picture wherever they
// overlap.
pub fn scale(m: RstMask, alpha: Float) -> RstMask []
    let k = math.clamp(alpha, 0.0, 1.0)
    var out = bytes.clone(m.coverage)
    for i in 0..bytes.len(out)
        let v = bytes.byte_at(m.coverage, i) ?? 0
        bytes.set_u8(out, i, math.round(v as Float * k) as Int)
    with_coverage(m, out)

// A mask re-measured over a different rectangle, zero-filled where the
// new rectangle reaches past the old.
//
// What `intersect` needs when two masks do not line up, and the one
// place the extent mismatch is repaired rather than refused — by a
// caller that asked for it, by name.
pub fn retarget(m: RstMask, extent: geomrect.GeomRectI,
                limits: RstLimits) -> Result<RstMask, rastererror.RstFault> []
    let want = match build(geomrect.width_i(extent), geomrect.height_i(extent),
                           extent.min.x, extent.min.y, 0, limits)
        Err(e) =>
            return Err(e)
        Ok(r)  => r
    let box = geomrect.intersection_i(rastermask.extent(m), rastermask.extent(want))
    var out = bytes.clone(want.coverage)
    if not geomrect.is_empty_i(box)
        let run = geomrect.width_i(box)
        for y in box.min.y..box.max.y
            bytes.copy_into(out, (y - want.origin_y) * want.width + box.min.x - want.origin_x,
                            m.coverage, (y - m.origin_y) * m.width + box.min.x - m.origin_x, run)
    Ok(with_coverage(want, out))

// ── One bit a pixel ──────────────────────────────────────────────────

// Every byte turned into 0 or 255 by comparing against `at_least`.
//
// The whole of the 1-bit conversion's first half.  128 is the usual
// threshold; a caller rendering small text on e-paper often wants
// lower, because anti-aliased stems are mostly partial coverage and a
// high threshold erases them.
pub fn threshold(m: RstMask, at_least: Int) -> RstMask []
    var out = bytes.clone(m.coverage)
    for i in 0..bytes.len(out)
        let on = (bytes.byte_at(m.coverage, i) ?? 0) >= at_least
        bytes.set_u8(out, i, (if on then 255 else 0))
    with_coverage(m, out)

// A thresholded mask's rows packed eight pixels to a byte, most
// significant bit leftmost.
//
// The second half, and the layout every monochrome panel controller
// and every 1-bit BMP expects.  Rows are padded to a whole byte, so
// the stride is `(width + 7) / 8`.
//
// Published rather than left to the caller because the bit ORDER is
// the thing a caller gets wrong once and then cannot see is wrong —
// a picture packed the other way looks like static.
pub fn pack_rows_1bit(m: RstMask) -> Bytes []
    let stride = (m.width + 7) / 8
    var out = bytes.zeros(stride * m.height)
    for y in 0..m.height
        for x in 0..m.width
            if (bytes.byte_at(m.coverage, y * m.width + x) ?? 0) >= 128
                let at = y * stride + x / 8
                bytes.set_u8(out, at, (bytes.byte_at(out, at) ?? 0) | (128 >> (x % 8)))
    out

// How many bytes `pack_rows_1bit` would answer.
pub fn packed_1bit_len(m: RstMask) -> Int []
    (m.width + 7) / 8 * m.height

// The largest pixel count the package will name.  A product past it
// is reported as this, so that the refusal carries a number instead of
// an overflowed one.
fn pixel_ceiling() -> Int
    4611686018427387904

// `width * height`, held at `pixel_ceiling` rather than overflowing.
fn pixels_of(width: Int, height: Int) -> Int
    if height > 0 and width > pixel_ceiling() / height
        return pixel_ceiling()
    width * height

// A mask of one value everywhere, after the budget check.
fn build(width: Int, height: Int, origin_x: Int, origin_y: Int, value: Int,
         limits: RstLimits) -> Result<RstMask, rastererror.RstFault>
    if width < 1 or height < 1
        core.panic.panic("raster-nv.rastermask: a mask is at least 1 by 1, not ${width} by ${height}")
    let want = pixels_of(width, height)
    if want > limits.max_pixels
        return Err(RstTooLarge(want, limits.max_pixels))
    var buf = bytes.zeros(want)
    if value != 0
        bytes.fill(buf, 0, want, value)
    Ok(RstMask { width: width, height: height, origin_x: origin_x, origin_y: origin_y,
                 coverage: buf })

// The same rectangle over other bytes.
fn with_coverage(m: RstMask, coverage: Bytes) -> RstMask
    RstMask { width: m.width, height: m.height, origin_x: m.origin_x, origin_y: m.origin_y,
              coverage: coverage }

// Whether every byte equals `value`.
fn all_equal(m: RstMask, value: Int) -> Bool
    for i in 0..bytes.len(m.coverage)
        if (bytes.byte_at(m.coverage, i) ?? 0) != value
            return false
    true

// Two masks combined byte by byte: 0 is the minimum, 1 the maximum
// and 2 the minimum of the first and the complement of the second.
fn combine(a: RstMask, b: RstMask, op: Int) -> Result<RstMask, rastererror.RstFault>
    if not same_extent(a, b)
        return Err(RstExtentMismatch(a.width, a.height, b.width, b.height))
    var out = bytes.clone(a.coverage)
    for i in 0..bytes.len(out)
        let x = bytes.byte_at(a.coverage, i) ?? 0
        let y = bytes.byte_at(b.coverage, i) ?? 0
        var v = math.min(x, y)
        if op == 1
            v = math.max(x, y)
        elif op == 2
            v = math.min(x, 255 - y)
        bytes.set_u8(out, i, v)
    Ok(with_coverage(a, out))
