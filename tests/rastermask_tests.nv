// rastermask_tests.nv - coverage is a value, and the value has an extent.
//
// The mask arithmetic is checked against numpy: two random 5 by 4 masks, and
// the minimum, maximum, complement, threshold, scale and bit packing numpy
// computes for them (tests/oracle/vectors.py prints the vectors).  The rest is
// the budget, the rectangle a mask carries, and the arithmetic between a
// path's bounds and the pixels a mask covers.

use std.test
use std.bytes
use geomrect
use rastermask
use rastererror

fn lim() -> rastermask.RstLimits
    RstLimits { max_pixels: 1024, max_edges: 4096 }

// A mask over a rectangle at an origin, from the hex of its bytes.
fn from_hex(w: Int, h: Int, ox: Int, oy: Int, hex: Str) -> rastermask.RstMask
    RstMask { width: w, height: h, origin_x: ox, origin_y: oy,
              coverage: bytes.from_hex(hex) ?? bytes.zeros(0) }

fn hex_of(m: rastermask.RstMask) -> Str
    bytes.to_hex(m.coverage)

fn unwrap(r: Result<rastermask.RstMask, rastererror.RstFault>) -> rastermask.RstMask
    match r
        Ok(m)  => m
        Err(_) => from_hex(1, 1, 0, 0, "00")

fn refused(r: Result<rastermask.RstMask, rastererror.RstFault>) -> Bool
    match r
        Ok(_)  => false
        Err(_) => true

fn mask_a() -> Str
    "c3770e9c35324179a5fa194014e758a7ca2d7d53"

fn mask_b() -> Str
    "00ff807f810547c4ae352f643cc2b31b2a0a6d58"

fn want_min() -> Str
    "00770e7f35054179a535194014c2581b2a0a6d53"

fn want_max() -> Str
    "c3ff809c813247c4aefa2f643ce7b3a7ca2d7d58"

fn want_subtract() -> Str
    "c3000e803532413b51ca1940143d4ca7ca2d7d53"

fn want_invert() -> Str
    "3c88f163cacdbe865a05e6bfeb18a75835d282ac"

fn want_threshold_100() -> Str
    "ffff00ff000000ffffff000000ff00ffff00ff00"

fn want_threshold_128() -> Str
    "ff0000ff00000000ffff000000ff00ffff000000"

fn want_scale_quarter() -> Str
    "311e04270d0d101e293f0610053a162a330b1f15"

fn want_packed() -> Str
    "901810c0"

@test
fn test_the_defaults_are_published() [io]
    let d = rastermask.default_limits()
    test.assert_eq(d.max_pixels, 67108864)
    test.assert_eq(d.max_edges, 1048576)

@test
fn test_the_size_crosses_the_interface_before_anything_is_allocated() [io]
    test.case("a mask within the budget is built, transparent")
    let m = unwrap(rastermask.mask(16, 16, 0, 0, lim()))
    test.assert_eq(m.width, 16)
    test.assert_eq(m.height, 16)
    test.assert_eq(bytes.len(m.coverage), 256)
    test.assert(rastermask.is_empty(m))

    test.case("one past the budget is refused carrying both numbers")
    match rastermask.mask(64, 64, 0, 0, lim())
        Ok(_)  => test.fail("a 4096 pixel mask passed a 1024 pixel budget")
        Err(e) =>
            test.assert(rastererror.is_budget(e))
            test.assert_eq_str(rastererror.describe(e), "a mask of 4096 pixels is past the limit of 1024")

    test.case("the size that is exactly the budget is allowed")
    test.assert(refused(rastermask.mask(32, 32, 0, 0, lim())) == false)
    test.assert(refused(rastermask.mask(33, 32, 0, 0, lim())))

    test.case("a size whose product overflows is still refused, with a number that did not wrap")
    match rastermask.full(3000000000, 3000000000, 0, 0, lim())
        Ok(_)  => test.fail("a mask of 9e18 pixels was built")
        Err(e) =>
            match e
                RstTooLarge(want, limit) =>
                    test.assert(want > 1000000000000)
                    test.assert_eq(limit, 1024)
                _                        => test.fail("the refusal was not a size")

    test.case("a mask smaller than one pixel is a programming error")
    test.assert_raises(() => rastermask.mask(0, 4, 0, 0, lim()))
    test.assert_raises(() => rastermask.full(4, -1, 0, 0, lim()))

@test
fn test_a_mask_carries_its_own_rectangle() [io]
    let m = unwrap(rastermask.mask(8, 6, 100, 50, lim()))
    test.case("the origin says where the box sits in the target")
    test.assert_eq(m.origin_x, 100)
    test.assert_eq(m.origin_y, 50)
    let e = rastermask.extent(m)
    test.assert_eq(e.min.x, 100)
    test.assert_eq(e.min.y, 50)
    test.assert_eq(geomrect.width_i(e), 8)
    test.assert_eq(geomrect.height_i(e), 6)

    test.case("a lookup is in target coordinates, and outside the box it is zero")
    let g = from_hex(2, 2, 10, 20, "01020304")
    test.assert_eq(rastermask.at(g, 10, 20), 1)
    test.assert_eq(rastermask.at(g, 11, 20), 2)
    test.assert_eq(rastermask.at(g, 10, 21), 3)
    test.assert_eq(rastermask.at(g, 11, 21), 4)
    test.assert_eq(rastermask.at(g, 9, 20), 0)
    test.assert_eq(rastermask.at(g, 12, 20), 0)
    test.assert_eq(rastermask.at(g, 10, 19), 0)
    test.assert_eq(rastermask.at(g, 10, 22), 0)

    test.case("a row is in mask coordinates")
    test.assert_eq_str(bytes.to_hex(rastermask.row(g, 1) ?? bytes.zeros(0)), "0304")
    test.assert(rastermask.row(g, 2) == None)
    test.assert(rastermask.row(g, -1) == None)

@test
fn test_full_empty_and_opaque() [io]
    let f = unwrap(rastermask.full(4, 3, -2, -1, lim()))
    test.assert(rastermask.is_opaque(f))
    test.assert(rastermask.is_empty(f) == false)
    test.assert_eq(rastermask.at(f, -2, -1), 255)
    test.assert_eq(rastermask.at(f, 1, 1), 255)
    let z = unwrap(rastermask.mask(4, 3, 0, 0, lim()))
    test.assert(rastermask.is_empty(z))
    test.assert(rastermask.is_opaque(z) == false)
    test.case("one byte off either extreme is neither")
    let almost = from_hex(2, 1, 0, 0, "ff00")
    test.assert(rastermask.is_empty(almost) == false)
    test.assert(rastermask.is_opaque(almost) == false)
    test.assert(rastermask.is_empty(from_hex(2, 1, 0, 0, "0001")) == false)
    test.assert(rastermask.is_opaque(from_hex(2, 1, 0, 0, "feff")) == false)

@test
fn test_the_pixel_box_is_rounded_outward() [io]
    test.case("a pixel a curve touches by a hundredth still has coverage")
    let e = rastermask.extent_for(geomrect.of_xywh(0.4, 0.4, 2.2, 2.2), 100, 100)
    test.assert_eq(e.min.x, 0)
    test.assert_eq(e.max.x, 3)
    test.assert_eq(geomrect.height_i(e), 3)
    let f = rastermask.extent_for(geomrect.of_xywh(2.99, 4.0, 0.02, 1.0), 100, 100)
    test.assert_eq(f.min.x, 2)
    test.assert_eq(f.max.x, 4)
    test.assert_eq(f.min.y, 4)
    test.assert_eq(f.max.y, 5)

    test.case("the box is held inside the target")
    let c = rastermask.extent_for(geomrect.of_xywh(-5.5, 8.5, 10.0, 10.0), 10, 10)
    test.assert_eq(c.min.x, 0)
    test.assert_eq(c.max.x, 5)
    test.assert_eq(c.min.y, 8)
    test.assert_eq(c.max.y, 10)

    test.case("a shape wholly off the target costs nothing")
    let off = rastermask.extent_for(geomrect.of_xywh(200.0, 200.0, 10.0, 10.0), 100, 100)
    test.assert(geomrect.is_empty_i(off))
    test.assert_eq(rastermask.cost_of(off), 0)
    test.assert(geomrect.is_empty_i(rastermask.extent_for(geomrect.empty(), 100, 100)))

@test
fn test_the_cost_of_an_extent() [io]
    test.assert_eq(rastermask.cost_of(geomrect.of_xywh_i(0, 0, 64, 64)), 4096)
    test.assert_eq(rastermask.cost_of(geomrect.of_xywh_i(-5, -5, 3, 7)), 21)
    test.assert_eq(rastermask.cost_of(geomrect.of_xywh_i(0, 0, 0, 9)), 0)
    test.assert(rastermask.cost_of(geomrect.of_xywh_i(0, 0, 4000000000, 4000000000)) > 1000000000000)

@test
fn test_the_ink_extent_trims_to_the_marks() [io]
    test.case("an empty mask has an empty ink box at its own origin")
    let z = unwrap(rastermask.mask(4, 4, 7, 9, lim()))
    let none = rastermask.ink_extent(z)
    test.assert(geomrect.is_empty_i(none))
    test.assert_eq(none.min.x, 7)
    test.assert_eq(none.min.y, 9)

    test.case("the box is the smallest around every nonzero byte, in target coordinates")
    let m = from_hex(4, 4, 10, 20, "00000000" + "00010000" + "00000002" + "00000000")
    let box = rastermask.ink_extent(m)
    test.assert_eq(box.min.x, 11)
    test.assert_eq(box.max.x, 14)
    test.assert_eq(box.min.y, 21)
    test.assert_eq(box.max.y, 23)

@test
fn test_the_combinations_agree_with_numpy() [io]
    let a = from_hex(5, 4, 3, -2, mask_a())
    let b = from_hex(5, 4, 3, -2, mask_b())
    test.case("intersect is the minimum, which is why a clip leaves a full pixel full")
    test.assert_eq_str(hex_of(unwrap(rastermask.intersect(a, b))), want_min())
    test.case("union is the maximum")
    test.assert_eq_str(hex_of(unwrap(rastermask.union(a, b))), want_max())
    test.case("subtract keeps what a covers and b does not")
    test.assert_eq_str(hex_of(unwrap(rastermask.subtract(a, b))), want_subtract())
    test.case("the result keeps the rectangle")
    let m = unwrap(rastermask.union(a, b))
    test.assert_eq(m.origin_x, 3)
    test.assert_eq(m.origin_y, -2)
    test.assert_eq(m.width, 5)
    test.assert_eq(m.height, 4)

    test.case("two full masks stay full under a clip, and a mask taken from itself leaves nothing")
    let f = unwrap(rastermask.full(4, 4, 0, 0, lim()))
    test.assert(rastermask.is_opaque(unwrap(rastermask.intersect(f, f))))
    test.assert(rastermask.is_opaque(unwrap(rastermask.union(f, f))))
    test.assert(rastermask.is_empty(unwrap(rastermask.subtract(f, f))))

@test
fn test_masks_over_different_rectangles_refuse_rather_than_guess() [io]
    let a = unwrap(rastermask.full(4, 4, 0, 0, lim()))
    let b = unwrap(rastermask.full(8, 8, 0, 0, lim()))
    let shifted = unwrap(rastermask.full(4, 4, 1, 0, lim()))
    test.assert(rastermask.same_extent(a, a))
    test.assert(rastermask.same_extent(a, b) == false)
    test.case("the same size at another origin is another rectangle")
    test.assert(rastermask.same_extent(a, shifted) == false)
    test.assert(rastermask.same_extent(a, unwrap(rastermask.full(4, 4, 0, 1, lim()))) == false)
    test.assert(rastermask.same_extent(a, unwrap(rastermask.full(4, 5, 0, 0, lim()))) == false)
    test.case("each combination answers the sizes it was given")
    match rastermask.intersect(a, b)
        Ok(_)  => test.fail("masks of different sizes were intersected")
        Err(e) =>
            test.assert(rastererror.is_budget(e) == false)
            test.assert_eq_str(rastererror.describe(e),
                               "two masks cover different rectangles: 4 by 4 and 8 by 8")
    test.assert(refused(rastermask.union(a, b)))
    test.assert(refused(rastermask.subtract(a, shifted)))

@test
fn test_invert_threshold_and_scale_agree_with_numpy() [io]
    let a = from_hex(5, 4, 0, 0, mask_a())
    test.assert_eq_str(hex_of(rastermask.invert(a)), want_invert())
    test.assert_eq_str(hex_of(rastermask.threshold(a, 100)), want_threshold_100())
    test.assert_eq_str(hex_of(rastermask.threshold(a, 128)), want_threshold_128())
    test.assert_eq_str(hex_of(rastermask.scale(a, 0.25)), want_scale_quarter())
    test.case("scaling to zero is empty, to one is the same, and out of range is held")
    test.assert(rastermask.is_empty(rastermask.scale(a, 0.0)))
    test.assert(rastermask.is_empty(rastermask.scale(a, -3.0)))
    test.assert_eq_str(hex_of(rastermask.scale(a, 1.0)), mask_a())
    test.assert_eq_str(hex_of(rastermask.scale(a, 7.5)), mask_a())
    let half = rastermask.scale(unwrap(rastermask.full(2, 2, 0, 0, lim())), 0.5)
    test.assert_eq(rastermask.at(half, 0, 0), 128)
    test.case("a threshold of 0 turns everything on and one past the top turns everything off")
    test.assert(rastermask.is_opaque(rastermask.threshold(a, 0)))
    test.assert(rastermask.is_empty(rastermask.threshold(a, 256)))
    test.case("inverting twice is the identity")
    test.assert_eq_str(hex_of(rastermask.invert(rastermask.invert(a))), mask_a())

@test
fn test_one_bit_packing_is_most_significant_bit_first() [io]
    let a = from_hex(5, 4, 0, 0, mask_a())
    test.case("numpy.packbits agrees on the layout")
    test.assert_eq(rastermask.packed_1bit_len(a), 4)
    test.assert_eq_str(bytes.to_hex(rastermask.pack_rows_1bit(a)), want_packed())

    test.case("a row of ten pixels pads to two bytes, the first pixel in the top bit")
    let w = from_hex(10, 1, 0, 0, "ff00ff000000" + "00ffffff")
    test.assert_eq(rastermask.packed_1bit_len(w), 2)
    test.assert_eq_str(bytes.to_hex(rastermask.pack_rows_1bit(w)), "a1c0")

    test.case("a pixel at 127 is off and at 128 is on")
    test.assert_eq_str(bytes.to_hex(rastermask.pack_rows_1bit(from_hex(2, 1, 0, 0, "7f80"))), "40")
    test.case("eight pixels fill one byte and the next row starts a new one")
    test.assert_eq_str(bytes.to_hex(rastermask.pack_rows_1bit(from_hex(8, 2, 0, 0, "ff000000000000ff" + "ffffffffffffffff"))),
                       "81ff")

@test
fn test_retarget_remeasures_over_another_rectangle() [io]
    let m = from_hex(2, 2, 10, 10, "01020304")
    test.case("a larger rectangle is zero-filled where it reaches past the old one")
    let big = unwrap(rastermask.retarget(m, geomrect.of_xywh_i(9, 9, 4, 4), lim()))
    test.assert_eq_str(hex_of(big), "00000000" + "00010200" + "00030400" + "00000000")
    test.assert_eq(big.origin_x, 9)
    test.assert_eq(big.origin_y, 9)
    test.case("a smaller rectangle crops")
    let small = unwrap(rastermask.retarget(m, geomrect.of_xywh_i(11, 10, 1, 2), lim()))
    test.assert_eq_str(hex_of(small), "0204")
    test.case("a rectangle that misses the old one entirely is empty")
    let miss = unwrap(rastermask.retarget(m, geomrect.of_xywh_i(50, 50, 3, 3), lim()))
    test.assert(rastermask.is_empty(miss))
    test.assert(rastermask.same_extent(miss, unwrap(rastermask.mask(3, 3, 50, 50, lim()))))
    test.case("the budget applies")
    test.assert(refused(rastermask.retarget(m, geomrect.of_xywh_i(0, 0, 100, 100), lim())))
    test.case("two masks that did not line up now do")
    let a = unwrap(rastermask.full(4, 4, 0, 0, lim()))
    let b = unwrap(rastermask.full(2, 2, 1, 1, lim()))
    test.assert(refused(rastermask.intersect(a, b)))
    let fitted = unwrap(rastermask.retarget(b, rastermask.extent(a), lim()))
    test.assert_eq_str(hex_of(unwrap(rastermask.intersect(a, fitted))),
                       "00000000" + "00ffff00" + "00ffff00" + "00000000")
